# Public names. Both must point at this machine; Caddy gets the certificates.
APP_DOMAIN=studio.example.com
MEDIA_DOMAIN=media.example.com

# Generate with: openssl rand -hex 32
SECRET=
DB_PASSWORD=

# MinIO root credentials, also used by the app to reach the bucket.
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_BUCKET=estudio

# Without SMTP the sign-in links are written to the app log (docker compose logs app).
SMTP_URL=
MAIL_FROM="Studio <no-reply@studio.example.com>"

# ── Phase 2: publishing to the networks (docs/phase-2.md). All optional: without them accounts stay manual. ──
# Seals the access tokens kept for each account. Generate with: openssl rand -base64 32
# Keep a copy somewhere safe: without this key every connected account has to be connected again.
TOKEN_KEY=
# A Meta app (Facebook Login + Instagram content publishing). Redirect URI to register: https://<APP_DOMAIN>/api/oauth/callback
META_APP_ID=
META_APP_SECRET=
# Only with Facebook Login for Business: the id of the login configuration made in the app, and (optional) the one for brands with
# prizes, which adds the messaging permissions. Without them the sign-in dialog asks for a list of permissions (docs/phase-2.md).
META_LOGIN_CONFIG_ID=
META_LOGIN_CONFIG_ID_PRIZES=
# A Google Cloud project with the YouTube Data API v3. Redirect URI to register: https://<APP_DOMAIN>/api/oauth/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── Phase 4: the rest of the networks, results and prizes (docs/phase-4.md). All optional; each switches on with its credentials. ──
# Redirect URI for each: https://<APP_DOMAIN>/api/oauth/callback. Bluesky needs no app, only TOKEN_KEY above.
THREADS_APP_ID=
THREADS_APP_SECRET=
# TikTok keeps every post private until it audits the app, and may refuse the audit for a tool that posts for a team (docs/phase-4.md).
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
# LinkedIn's API is versioned by month and each version is retired after about a year: raise this when the studio says so.
LINKEDIN_VERSION=202604
X_CLIENT_ID=
X_CLIENT_SECRET=
PINTEREST_APP_ID=
PINTEREST_APP_SECRET=
# Prizes for commenting: any long random string, registered in the Meta app with https://<APP_DOMAIN>/api/meta/webhook
META_WEBHOOK_VERIFY_TOKEN=

# ── Phase 5: signing in, notifications, uploads (docs/phase-5.md). All optional. ──
# Admins and approvers give a code from an authenticator app after signing in. On by default here; set false only to turn it off.
SECOND_FACTOR_REQUIRED=
# Single sign-on with any OpenID Connect provider. Redirect URI to register: https://<APP_DOMAIN>/api/auth/sso/callback
# Google Workspace: https://accounts.google.com    Microsoft Entra: https://login.microsoftonline.com/<tenant>/v2.0
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_LABEL=Google Workspace
# Required with single sign-on: the email domains that may use it, comma separated (example.com,example.org)
OIDC_ALLOWED_DOMAINS=
# app: admins and approvers also give an authenticator code. idp: you say the provider enforces its own second step.
OIDC_SECOND_FACTOR=app
# Only for a single-tenant Microsoft Entra issuer, which does not say an email is verified.
OIDC_TRUST_EMAIL=
# false when everyone signs in with single sign-on (needs the OIDC_* values above)
EMAIL_LINK_LOGIN=
# true to also ask YouTube for the Analytics permission (watch time). The Google project must be verified for this scope.
GOOGLE_ANALYTICS=
# How much one brand may have waiting in unfinished big uploads on the staging volume, in GB. Empty: 20.
STAGING_MAX_GB_PER_BRAND=
