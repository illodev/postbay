# Public names. Both must point at this machine; Caddy gets the certificates.
APP_DOMAIN=studio.example.com
MEDIA_DOMAIN=media.example.com

# Generate with: openssl rand -hex 32
SECRET=
DB_PASSWORD=

# MinIO root credentials, also used by the app to reach the bucket.
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_BUCKET=estudio

# Without SMTP the sign-in links are written to the app log (docker compose logs app).
SMTP_URL=
MAIL_FROM="Studio <no-reply@studio.example.com>"

# ── Phase 2: publishing to the networks (docs/phase-2.md). All optional: without them accounts stay manual. ──
# Seals the access tokens kept for each account. Generate with: openssl rand -base64 32
# Keep a copy somewhere safe: without this key every connected account has to be connected again.
TOKEN_KEY=
# A Meta app (Facebook Login + Instagram content publishing). Redirect URI to register: https://<APP_DOMAIN>/api/oauth/callback
META_APP_ID=
META_APP_SECRET=
# A Google Cloud project with the YouTube Data API v3. Redirect URI to register: https://<APP_DOMAIN>/api/oauth/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
