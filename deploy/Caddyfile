# Two names, one machine: the app, and a media domain that only serves signed URLs from the bucket.
# Several networks download files from a URL instead of receiving them, and some want the domain verified first,
# so the media domain is stable and separate from the app.
{$APP_DOMAIN} {
	encode zstd gzip
	reverse_proxy app:3000
}

{$MEDIA_DOMAIN} {
	reverse_proxy minio:9000
}
