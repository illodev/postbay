# Database
DATABASE_URL=postgres://estudio:estudio@localhost:5432/estudio

# Public address of the app (used for the sign-in links sent by email)
APP_URL=http://localhost:5173
# Media domain: serves signed URLs only (see docs/phase-1.md)
MEDIA_URL=http://localhost:3000

# Secret used to sign local media URLs (at least 32 characters)
SECRET=change-this-to-a-long-random-value-of-32-or-more

# Storage: "local" (disk, for development) or "s3" (self-hosted MinIO, S3 or R2)
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=.data/media
# S3_ENDPOINT=http://minio:9000
# S3_REGION=auto
# S3_BUCKET=estudio
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_FORCE_PATH_STYLE=true

# Email. Without SMTP_URL, sign-in links are written to the server log.
# SMTP_URL=smtp://user:password@smtp.example.com:587
# MAIL_FROM="Studio <no-reply@example.com>"

# Development only: instant sign-in by email, no link. Ignored when NODE_ENV=production.
AUTH_DEV_LOGIN=false

# ── Phase 2: publishing to the networks (see docs/phase-2.md). All optional. ──
# Seals the tokens kept for connected accounts (32 bytes, base64): openssl rand -base64 32
# Required as soon as META_* or GOOGLE_* is set. Losing it means connecting every account again.
# TOKEN_KEY=
# Meta app: Facebook Pages and the Instagram accounts linked to them. Redirect URI: $APP_URL/api/oauth/callback
# META_APP_ID=
# META_APP_SECRET=
# Google project with the YouTube Data API v3. Redirect URI: $APP_URL/api/oauth/callback
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# Workers. By default the API process also runs the queue. Set false when a separate worker process runs
# (npm run worker, or node apps/api/dist/worker-main.js).
# RUN_WORKERS=true
# How often the queue looks for work that is due, in seconds.
# WORKER_SWEEP_SECONDS=15
# How long a file handed to a network by URL stays downloadable, in seconds (default 6 hours).
# PUBLIC_MEDIA_TTL_SECONDS=21600

# ── Phase 3: webhooks and the agent (see docs/phase-3.md) ──
# Webhook secrets are sealed with TOKEN_KEY (above), so webhooks need it. The agent's limits are set per brand in Settings → Agent.
# Where a webhook may point. By default (development) private and loopback addresses are allowed so a runner on the same machine
# works; in production only public addresses over https are, unless this is true. Cloud metadata and link-local addresses are
# refused whatever this says.
# WEBHOOK_ALLOW_PRIVATE_NETWORKS=false

# ── Phase 4: the rest of the networks, results and prizes (see docs/phase-4.md). All optional; each network is switched on by its credentials. ──
# Every network below needs TOKEN_KEY (above). Redirect URI for each: $APP_URL/api/oauth/callback
# Threads (Meta developer portal, "Threads API" use case)
# THREADS_APP_ID=
# THREADS_APP_SECRET=
# TikTok (developer portal, Content Posting API). Until TikTok audits the app every post is private; its own rules call tools that
# post for a team's accounts "not acceptable", so the audit may be refused (docs/phase-4.md).
# TIKTOK_CLIENT_KEY=
# TIKTOK_CLIENT_SECRET=
# LinkedIn (Community Management or "Share on LinkedIn" product). Its API is versioned by month and each version is retired after about a year:
# raise this when LinkedIn says the version is retired (the app says so in the post's history).
# LINKEDIN_CLIENT_ID=
# LINKEDIN_CLIENT_SECRET=
# LINKEDIN_VERSION=202604
# X (OAuth 2.0 with PKCE). Posting is billed per post by X (docs/phase-4.md).
# X_CLIENT_ID=
# X_CLIENT_SECRET=
# Pinterest (needs Standard access for pins to be visible to others)
# PINTEREST_APP_ID=
# PINTEREST_APP_SECRET=
# Bluesky needs no app: it is connected with a handle and an app password, as soon as TOKEN_KEY is set. Only for a self-hosted server:
# BLUESKY_PDS_URL=https://bsky.social
# BLUESKY_VIDEO_URL=https://video.bsky.app

# Prizes for commenting: the token Meta sends back when you register the webhook ($APP_URL/api/meta/webhook). Any long random string.
# Also register $APP_URL/api/meta/data-deletion as the data deletion callback and $APP_URL/data-deletion as its instructions page.
# META_WEBHOOK_VERIFY_TOKEN=
# How often the readings (1 hour, 1 day, 7 days, 28 days after a post) and the comments of posts with a running prize are looked at, in seconds.
# METRICS_SWEEP_SECONDS=120
# PRIZE_POLL_SECONDS=180
# How often the people whose retention period has ended are deleted, in seconds (default: every hour).
# PRIZE_PURGE_SECONDS=3600
